# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# prisma
/generated/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local database inspection / cleanup scripts
#
# Both talk to whatever DATABASE_URL points at and are NOT part of the
# production deployment workflow:
#   _inspect.mjs       prints raw rows, including AccessToken.tokenHash and
#                      user email/phone (PII)
#   _e2e-cleanup.mjs   issues deleteMany() against User and CoalListing
# Keep them on the developer's machine; never ship or run them on the server.
/_inspect.mjs
/_e2e-cleanup.mjs

# NOTE: tests/ is deliberately NOT ignored. `next build` type-checks the
# tests/**/*.ts tree via the tsconfig "include" glob, so the suites must be
# present in the repository at build time even though they never run in
# production.

# local AI / editor tooling (not application code)
/.agents/
/.claude/
/.cursor/
/.devin/

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents the admin login variables and holds
# placeholder values only.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
