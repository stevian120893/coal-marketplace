generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// An application user: an admin operator or a buyer company.
model User {
  id            String         @id @default(cuid())
  companyName   String?
  name          String?
  phone         String?
  email         String?        @unique
  role          UserRole       @default(BUYER)
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accessTokens  AccessToken[]
  quoteRequests QuoteRequest[]
  transactions  Transaction[]

  @@index([status])
  @@index([phone])
  @@index([companyName])
}

/// A coal lot offered for sale.
model CoalListing {
  id            String         @id @default(cuid())
  title         String
  origin        String?
  gar           Decimal?       @db.Decimal(5, 2)
  tm            Decimal?       @db.Decimal(5, 2)
  ash           Decimal?       @db.Decimal(5, 2)
  sulfur        Decimal?       @db.Decimal(5, 2)
  quantity      Decimal?       @db.Decimal(12, 3)
  status        ListingStatus  @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  accessTokens  AccessToken[]
  coa           COA[]
  photos        CoalPhoto[]
  quoteRequests QuoteRequest[]
  transactions  Transaction[]

  @@index([status])
  @@index([origin])
  @@index([createdAt])
}

/// Certificate of Analysis document for a listing.
model COA {
  id            String      @id @default(cuid())
  coalListingId String
  fileUrl       String
  uploadedAt    DateTime    @default(now())
  coalListing   CoalListing @relation(fields: [coalListingId], references: [id], onDelete: Cascade)

  @@index([coalListingId])
}

/// Photo of a coal lot.
model CoalPhoto {
  id            String      @id @default(cuid())
  coalListingId String
  fileUrl       String
  createdAt     DateTime    @default(now())
  coalListing   CoalListing @relation(fields: [coalListingId], references: [id], onDelete: Cascade)

  @@index([coalListingId])
}

/// Single-use magic link granting one buyer access to one listing.
/// Only the SHA-256 hash of the token is stored, never the token itself.
model AccessToken {
  id            String      @id @default(cuid())
  userId        String
  coalListingId String
  tokenHash     String      @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())
  coalListing   CoalListing @relation(fields: [coalListingId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([coalListingId])
  @@index([expiresAt])
}

/// A buyer's request for a price on a listing.
model QuoteRequest {
  id            String             @id @default(cuid())
  userId        String
  coalListingId String
  quantity      Decimal            @db.Decimal(12, 3)
  paymentTerms  String?
  notes         String?
  status        QuoteRequestStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  coalListing   CoalListing        @relation(fields: [coalListingId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction?

  @@index([userId])
  @@index([coalListingId])
  @@index([status])
  @@index([createdAt])
}

/// A confirmed sale arising from an accepted quote request.
model Transaction {
  id             String            @id @default(cuid())
  quoteRequestId String            @unique
  userId         String
  coalListingId  String
  quantity       Decimal           @db.Decimal(12, 3)
  price          Decimal           @db.Decimal(14, 2)
  paymentTerms   String?
  status         TransactionStatus @default(PENDING)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  coalListing    CoalListing       @relation(fields: [coalListingId], references: [id], onDelete: Cascade)
  quoteRequest   QuoteRequest      @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([coalListingId])
  @@index([status])
  @@index([createdAt])
}

enum UserRole {
  ADMIN
  BUYER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  SOLD
}

enum QuoteRequestStatus {
  PENDING
  QUOTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}
