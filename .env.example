# Local environment template. Copy to .env and fill in real values.
# .env is gitignored; this template is committed and must never hold a secret.

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:5432/database

# Admin console login. Both are required: the app fails closed if either is
# missing, so nobody can sign in without them.
#
# ADMIN_EMAIL must also match the email of a User row whose role is ADMIN and
# status is ACTIVE. The pair alone is not a permission - create the account with:
#   npm run admin:provision
ADMIN_EMAIL=admin@example.com

# Use a long random value, e.g. `openssl rand -base64 32`. Compared against
# submissions with a constant-time comparison; never stored or logged in clear.
ADMIN_PASSWORD=

# Public origin used to build absolute URLs (the admin console reads its own
# JSON API over HTTP from the server, and buyer magic links are minted as
# https://<origin>/offer/<slug>-<secret>).
#
# Leave it unset in local development: the origin is then derived from the
# incoming request. Set it in production whenever the app sits behind a reverse
# proxy, so the scheme and host do not depend on forwarded headers.
#
# The value is the app's full public base, matching basePath in
# lib/base-path.ts. For a subdirectory deployment include the subdirectory:
#   APP_BASE_URL=https://www.myinfiniteboon.com/ejs-coal
# A bare origin is also accepted and the subdirectory is appended for you, so
# the two spellings cannot produce a broken URL. Do not add a trailing slash.
APP_BASE_URL=https://example.com
